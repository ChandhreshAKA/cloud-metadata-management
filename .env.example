# Copy to .env and edit. .env is git-ignored. Never commit real values.
# The application reads ENVIRONMENT VARIABLES only; python-dotenv just loads this file into them at start-up.
 
# Oracle (thin mode: no Oracle Instant Client needed)
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=cloudmeta
ORACLE_PASSWORD=put-your-cloudmeta-password-here

# JWT signing key: at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string-before-use
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Master key that wraps each file data key (AES-256, 32 bytes, base64). This stands in for a cloud
# KMS key and must be kept secret and backed up: losing it makes every stored file unreadable.
# Generate one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=put-a-generated-base64-key-here
MASTER_KEY_VERSION=1

# Uploads larger than this many bytes are refused (default 50 MiB = 52428800)
MAX_UPLOAD_BYTES=52428800

# SIMULATED provider folders are created under this directory (git-ignored)
STORAGE_ROOT=storage_sim

# Connection pool
DB_POOL_MIN=1
DB_POOL_MAX=5

# dev | test | production  (production refuses the placeholder JWT secret)
APP_ENV=dev

# Only for the integration tests: set to 1 to run tests that need a live Oracle
RUN_INTEGRATION=0
